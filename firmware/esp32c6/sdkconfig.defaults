CONFIG_IDF_TARGET="esp32c6"

# The WROOM-1-N8 has 8 MB, but the table fits 4 MB, as the heatlink's (CLAUDE.md: 4 MB partitions).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

# 160 MHz, the C6's maximum.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# The console (and the logs) on the USB-Serial-JTAG, the house USB connector J4. UART0 (the debug
# pads) carries the ROM bootloader's output only.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 1 ms ticks, so relay cycle's times and the button's 5 ms poll are exact.
CONFIG_FREERTOS_HZ=1000

# The brown-out detector stays on (its default): Gate 2 checks that relay cycling doesn't trip it.
CONFIG_ESP_BROWNOUT_DET=y

# Crashes are saved to flash (read with: idf.py coredump-info).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# OTA rollback, ready for slice 3 (Fleet OTA).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Task watchdog: panic and restart if a task hogs the CPU for 5 s (a restart leaves the relay off).
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_PANIC=y
