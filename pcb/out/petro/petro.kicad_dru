(version 1)
(rule "LINE to the rest (250 V)"
  (constraint clearance (min 2.5mm))
  (constraint creepage (min 2.5mm))
  (condition "A.hasNetclass('LINE') && !(B.hasNetclass('LINE') || B.hasNetclass('LIVE') || B.hasNetclass('PSU') || B.hasNetclass('NEUTRAL') || B.hasNetclass('LOAD') || B.hasNetclass('DIV1') || B.hasNetclass('DIV2') || B.hasNetclass('DIV3') || B.hasNetclass('DIV4') || B.hasNetclass('SWNODE') || B.hasNetclass('BUS'))"))
(rule "LIVE to the rest (250 V)"
  (constraint clearance (min 2.5mm))
  (constraint creepage (min 2.5mm))
  (condition "A.hasNetclass('LIVE') && !(B.hasNetclass('LINE') || B.hasNetclass('LIVE') || B.hasNetclass('PSU') || B.hasNetclass('NEUTRAL') || B.hasNetclass('LOAD') || B.hasNetclass('DIV1') || B.hasNetclass('DIV2') || B.hasNetclass('DIV3') || B.hasNetclass('DIV4') || B.hasNetclass('SWNODE') || B.hasNetclass('BUS'))"))
(rule "PSU to the rest (250 V)"
  (constraint clearance (min 2.5mm))
  (constraint creepage (min 2.5mm))
  (condition "A.hasNetclass('PSU') && !(B.hasNetclass('LINE') || B.hasNetclass('LIVE') || B.hasNetclass('PSU') || B.hasNetclass('NEUTRAL') || B.hasNetclass('LOAD') || B.hasNetclass('DIV1') || B.hasNetclass('DIV2') || B.hasNetclass('DIV3') || B.hasNetclass('DIV4') || B.hasNetclass('SWNODE') || B.hasNetclass('BUS'))"))
(rule "LOAD to the rest (250 V)"
  (constraint clearance (min 2.5mm))
  (constraint creepage (min 2.5mm))
  (condition "A.hasNetclass('LOAD') && !(B.hasNetclass('LINE') || B.hasNetclass('LIVE') || B.hasNetclass('PSU') || B.hasNetclass('NEUTRAL') || B.hasNetclass('LOAD') || B.hasNetclass('DIV1') || B.hasNetclass('DIV2') || B.hasNetclass('DIV3') || B.hasNetclass('DIV4') || B.hasNetclass('SWNODE') || B.hasNetclass('BUS'))"))
(rule "DIV1 to the rest (50 V)"
  (constraint clearance (min 1.2mm))
  (constraint creepage (min 1.2mm))
  (condition "A.hasNetclass('DIV1') && !(B.hasNetclass('LINE') || B.hasNetclass('LIVE') || B.hasNetclass('PSU') || B.hasNetclass('NEUTRAL') || B.hasNetclass('LOAD') || B.hasNetclass('DIV1') || B.hasNetclass('DIV2') || B.hasNetclass('DIV3') || B.hasNetclass('DIV4') || B.hasNetclass('SWNODE') || B.hasNetclass('BUS'))"))
(rule "DIV2 to the rest (100 V)"
  (constraint clearance (min 1.4mm))
  (constraint creepage (min 1.4mm))
  (condition "A.hasNetclass('DIV2') && !(B.hasNetclass('LINE') || B.hasNetclass('LIVE') || B.hasNetclass('PSU') || B.hasNetclass('NEUTRAL') || B.hasNetclass('LOAD') || B.hasNetclass('DIV1') || B.hasNetclass('DIV2') || B.hasNetclass('DIV3') || B.hasNetclass('DIV4') || B.hasNetclass('SWNODE') || B.hasNetclass('BUS'))"))
(rule "DIV3 to the rest (150 V)"
  (constraint clearance (min 1.6mm))
  (constraint creepage (min 1.6mm))
  (condition "A.hasNetclass('DIV3') && !(B.hasNetclass('LINE') || B.hasNetclass('LIVE') || B.hasNetclass('PSU') || B.hasNetclass('NEUTRAL') || B.hasNetclass('LOAD') || B.hasNetclass('DIV1') || B.hasNetclass('DIV2') || B.hasNetclass('DIV3') || B.hasNetclass('DIV4') || B.hasNetclass('SWNODE') || B.hasNetclass('BUS'))"))
(rule "DIV4 to the rest (200 V)"
  (constraint clearance (min 2mm))
  (constraint creepage (min 2mm))
  (condition "A.hasNetclass('DIV4') && !(B.hasNetclass('LINE') || B.hasNetclass('LIVE') || B.hasNetclass('PSU') || B.hasNetclass('NEUTRAL') || B.hasNetclass('LOAD') || B.hasNetclass('DIV1') || B.hasNetclass('DIV2') || B.hasNetclass('DIV3') || B.hasNetclass('DIV4') || B.hasNetclass('SWNODE') || B.hasNetclass('BUS'))"))
(rule "SWNODE to the rest (1 mm)"
  (constraint clearance (min 1mm))
  (constraint creepage (min 1mm))
  (condition "A.hasNetclass('SWNODE') && !(B.hasNetclass('LINE') || B.hasNetclass('LIVE') || B.hasNetclass('PSU') || B.hasNetclass('NEUTRAL') || B.hasNetclass('LOAD') || B.hasNetclass('DIV1') || B.hasNetclass('DIV2') || B.hasNetclass('DIV3') || B.hasNetclass('DIV4') || B.hasNetclass('SWNODE') || B.hasNetclass('BUS'))"))
(rule "BUS to the rest (353.553 V)"
  (constraint clearance (min 3.55mm))
  (constraint creepage (min 3.55mm))
  (condition "A.hasNetclass('BUS') && !(B.hasNetclass('LINE') || B.hasNetclass('LIVE') || B.hasNetclass('PSU') || B.hasNetclass('NEUTRAL') || B.hasNetclass('LOAD') || B.hasNetclass('DIV1') || B.hasNetclass('DIV2') || B.hasNetclass('DIV3') || B.hasNetclass('DIV4') || B.hasNetclass('SWNODE') || B.hasNetclass('BUS'))"))
(rule "LINE to LIVE (250 V)"
  (constraint clearance (min 2.5mm))
  (constraint creepage (min 2.5mm))
  (condition "A.hasNetclass('LINE') && B.hasNetclass('LIVE')"))
(rule "LINE to PSU (250 V)"
  (constraint clearance (min 2.5mm))
  (constraint creepage (min 2.5mm))
  (condition "A.hasNetclass('LINE') && B.hasNetclass('PSU')"))
(rule "LINE to NEUTRAL (250 V)"
  (constraint clearance (min 2.5mm))
  (constraint creepage (min 2.5mm))
  (condition "A.hasNetclass('LINE') && B.hasNetclass('NEUTRAL')"))
(rule "LINE to LOAD (250 V)"
  (constraint clearance (min 2.5mm))
  (constraint creepage (min 2.5mm))
  (condition "A.hasNetclass('LINE') && B.hasNetclass('LOAD')"))
(rule "LINE to SWNODE (433.013 V)"
  (constraint clearance (min 4.35mm))
  (constraint creepage (min 4.35mm))
  (condition "A.hasNetclass('LINE') && B.hasNetclass('SWNODE')"))
(rule "LIVE to PSU (250 V)"
  (constraint clearance (min 2.5mm))
  (constraint creepage (min 2.5mm))
  (condition "A.hasNetclass('LIVE') && B.hasNetclass('PSU')"))
(rule "LIVE to NEUTRAL (250 V)"
  (constraint clearance (min 2.5mm))
  (constraint creepage (min 2.5mm))
  (condition "A.hasNetclass('LIVE') && B.hasNetclass('NEUTRAL')"))
(rule "LIVE to LOAD (250 V)"
  (constraint clearance (min 2.5mm))
  (constraint creepage (min 2.5mm))
  (condition "A.hasNetclass('LIVE') && B.hasNetclass('LOAD')"))
(rule "LIVE to SWNODE (433.013 V)"
  (constraint clearance (min 4.35mm))
  (constraint creepage (min 4.35mm))
  (condition "A.hasNetclass('LIVE') && B.hasNetclass('SWNODE')"))
(rule "PSU to SWNODE (1 mm)"
  (constraint clearance (min 1mm))
  (constraint creepage (min 1mm))
  (condition "A.hasNetclass('PSU') && B.hasNetclass('SWNODE')"))
(rule "NEUTRAL to PSU (250 V)"
  (constraint clearance (min 2.5mm))
  (constraint creepage (min 2.5mm))
  (condition "A.hasNetclass('NEUTRAL') && B.hasNetclass('PSU')"))
(rule "NEUTRAL to SWNODE (1 mm)"
  (constraint clearance (min 1mm))
  (constraint creepage (min 1mm))
  (condition "A.hasNetclass('NEUTRAL') && B.hasNetclass('SWNODE')"))
(rule "LOAD to PSU (250 V)"
  (constraint clearance (min 2.5mm))
  (constraint creepage (min 2.5mm))
  (condition "A.hasNetclass('LOAD') && B.hasNetclass('PSU')"))
(rule "LOAD to NEUTRAL (250 V)"
  (constraint clearance (min 2.5mm))
  (constraint creepage (min 2.5mm))
  (condition "A.hasNetclass('LOAD') && B.hasNetclass('NEUTRAL')"))
(rule "LOAD to SWNODE (433.013 V)"
  (constraint clearance (min 4.35mm))
  (constraint creepage (min 4.35mm))
  (condition "A.hasNetclass('LOAD') && B.hasNetclass('SWNODE')"))
(rule "DIV1 to LINE (200 V)"
  (constraint clearance (min 2mm))
  (constraint creepage (min 2mm))
  (condition "A.hasNetclass('DIV1') && B.hasNetclass('LINE')"))
(rule "DIV1 to LIVE (200 V)"
  (constraint clearance (min 2mm))
  (constraint creepage (min 2mm))
  (condition "A.hasNetclass('DIV1') && B.hasNetclass('LIVE')"))
(rule "DIV1 to PSU (200 V)"
  (constraint clearance (min 2mm))
  (constraint creepage (min 2mm))
  (condition "A.hasNetclass('DIV1') && B.hasNetclass('PSU')"))
(rule "DIV1 to NEUTRAL (50 V)"
  (constraint clearance (min 1.2mm))
  (constraint creepage (min 1.2mm))
  (condition "A.hasNetclass('DIV1') && B.hasNetclass('NEUTRAL')"))
(rule "DIV1 to LOAD (200 V)"
  (constraint clearance (min 2mm))
  (constraint creepage (min 2mm))
  (condition "A.hasNetclass('DIV1') && B.hasNetclass('LOAD')"))
(rule "DIV1 to DIV2 (50 V)"
  (constraint clearance (min 1.2mm))
  (constraint creepage (min 1.2mm))
  (condition "A.hasNetclass('DIV1') && B.hasNetclass('DIV2')"))
(rule "DIV1 to DIV3 (100 V)"
  (constraint clearance (min 1.4mm))
  (constraint creepage (min 1.4mm))
  (condition "A.hasNetclass('DIV1') && B.hasNetclass('DIV3')"))
(rule "DIV1 to DIV4 (150 V)"
  (constraint clearance (min 1.6mm))
  (constraint creepage (min 1.6mm))
  (condition "A.hasNetclass('DIV1') && B.hasNetclass('DIV4')"))
(rule "DIV1 to SWNODE (357.071 V)"
  (constraint clearance (min 3.6mm))
  (constraint creepage (min 3.6mm))
  (condition "A.hasNetclass('DIV1') && B.hasNetclass('SWNODE')"))
(rule "DIV2 to LINE (150 V)"
  (constraint clearance (min 1.6mm))
  (constraint creepage (min 1.6mm))
  (condition "A.hasNetclass('DIV2') && B.hasNetclass('LINE')"))
(rule "DIV2 to LIVE (150 V)"
  (constraint clearance (min 1.6mm))
  (constraint creepage (min 1.6mm))
  (condition "A.hasNetclass('DIV2') && B.hasNetclass('LIVE')"))
(rule "DIV2 to PSU (150 V)"
  (constraint clearance (min 1.6mm))
  (constraint creepage (min 1.6mm))
  (condition "A.hasNetclass('DIV2') && B.hasNetclass('PSU')"))
(rule "DIV2 to NEUTRAL (100 V)"
  (constraint clearance (min 1.4mm))
  (constraint creepage (min 1.4mm))
  (condition "A.hasNetclass('DIV2') && B.hasNetclass('NEUTRAL')"))
(rule "DIV2 to LOAD (150 V)"
  (constraint clearance (min 1.6mm))
  (constraint creepage (min 1.6mm))
  (condition "A.hasNetclass('DIV2') && B.hasNetclass('LOAD')"))
(rule "DIV2 to DIV3 (50 V)"
  (constraint clearance (min 1.2mm))
  (constraint creepage (min 1.2mm))
  (condition "A.hasNetclass('DIV2') && B.hasNetclass('DIV3')"))
(rule "DIV2 to DIV4 (100 V)"
  (constraint clearance (min 1.4mm))
  (constraint creepage (min 1.4mm))
  (condition "A.hasNetclass('DIV2') && B.hasNetclass('DIV4')"))
(rule "DIV2 to SWNODE (367.423 V)"
  (constraint clearance (min 3.7mm))
  (constraint creepage (min 3.7mm))
  (condition "A.hasNetclass('DIV2') && B.hasNetclass('SWNODE')"))
(rule "DIV3 to LINE (100 V)"
  (constraint clearance (min 1.4mm))
  (constraint creepage (min 1.4mm))
  (condition "A.hasNetclass('DIV3') && B.hasNetclass('LINE')"))
(rule "DIV3 to LIVE (150 V)"
  (constraint clearance (min 1.6mm))
  (constraint creepage (min 1.6mm))
  (condition "A.hasNetclass('DIV3') && B.hasNetclass('LIVE')"))
(rule "DIV3 to PSU (150 V)"
  (constraint clearance (min 1.6mm))
  (constraint creepage (min 1.6mm))
  (condition "A.hasNetclass('DIV3') && B.hasNetclass('PSU')"))
(rule "DIV3 to NEUTRAL (150 V)"
  (constraint clearance (min 1.6mm))
  (constraint creepage (min 1.6mm))
  (condition "A.hasNetclass('DIV3') && B.hasNetclass('NEUTRAL')"))
(rule "DIV3 to LOAD (150 V)"
  (constraint clearance (min 1.6mm))
  (constraint creepage (min 1.6mm))
  (condition "A.hasNetclass('DIV3') && B.hasNetclass('LOAD')"))
(rule "DIV3 to DIV4 (50 V)"
  (constraint clearance (min 1.2mm))
  (constraint creepage (min 1.2mm))
  (condition "A.hasNetclass('DIV3') && B.hasNetclass('DIV4')"))
(rule "DIV3 to SWNODE (384.057 V)"
  (constraint clearance (min 3.85mm))
  (constraint creepage (min 3.85mm))
  (condition "A.hasNetclass('DIV3') && B.hasNetclass('SWNODE')"))
(rule "DIV4 to LINE (50 V)"
  (constraint clearance (min 1.2mm))
  (constraint creepage (min 1.2mm))
  (condition "A.hasNetclass('DIV4') && B.hasNetclass('LINE')"))
(rule "DIV4 to LIVE (200 V)"
  (constraint clearance (min 2mm))
  (constraint creepage (min 2mm))
  (condition "A.hasNetclass('DIV4') && B.hasNetclass('LIVE')"))
(rule "DIV4 to PSU (200 V)"
  (constraint clearance (min 2mm))
  (constraint creepage (min 2mm))
  (condition "A.hasNetclass('DIV4') && B.hasNetclass('PSU')"))
(rule "DIV4 to NEUTRAL (200 V)"
  (constraint clearance (min 2mm))
  (constraint creepage (min 2mm))
  (condition "A.hasNetclass('DIV4') && B.hasNetclass('NEUTRAL')"))
(rule "DIV4 to LOAD (200 V)"
  (constraint clearance (min 2mm))
  (constraint creepage (min 2mm))
  (condition "A.hasNetclass('DIV4') && B.hasNetclass('LOAD')"))
(rule "DIV4 to SWNODE (406.202 V)"
  (constraint clearance (min 4.1mm))
  (constraint creepage (min 4.1mm))
  (condition "A.hasNetclass('DIV4') && B.hasNetclass('SWNODE')"))
(rule "BUS to LINE (433.013 V)"
  (constraint clearance (min 4.35mm))
  (constraint creepage (min 4.35mm))
  (condition "A.hasNetclass('BUS') && B.hasNetclass('LINE')"))
(rule "BUS to LIVE (433.013 V)"
  (constraint clearance (min 4.35mm))
  (constraint creepage (min 4.35mm))
  (condition "A.hasNetclass('BUS') && B.hasNetclass('LIVE')"))
(rule "BUS to PSU (433.013 V)"
  (constraint clearance (min 4.35mm))
  (constraint creepage (min 4.35mm))
  (condition "A.hasNetclass('BUS') && B.hasNetclass('PSU')"))
(rule "BUS to NEUTRAL (353.553 V)"
  (constraint clearance (min 3.55mm))
  (constraint creepage (min 3.55mm))
  (condition "A.hasNetclass('BUS') && B.hasNetclass('NEUTRAL')"))
(rule "BUS to LOAD (433.013 V)"
  (constraint clearance (min 4.35mm))
  (constraint creepage (min 4.35mm))
  (condition "A.hasNetclass('BUS') && B.hasNetclass('LOAD')"))
(rule "BUS to DIV1 (357.071 V)"
  (constraint clearance (min 3.6mm))
  (constraint creepage (min 3.6mm))
  (condition "A.hasNetclass('BUS') && B.hasNetclass('DIV1')"))
(rule "BUS to DIV2 (367.423 V)"
  (constraint clearance (min 3.7mm))
  (constraint creepage (min 3.7mm))
  (condition "A.hasNetclass('BUS') && B.hasNetclass('DIV2')"))
(rule "BUS to DIV3 (384.057 V)"
  (constraint clearance (min 3.85mm))
  (constraint creepage (min 3.85mm))
  (condition "A.hasNetclass('BUS') && B.hasNetclass('DIV3')"))
(rule "BUS to DIV4 (406.202 V)"
  (constraint clearance (min 4.1mm))
  (constraint creepage (min 4.1mm))
  (condition "A.hasNetclass('BUS') && B.hasNetclass('DIV4')"))
(rule "BUS to SWNODE (1 mm)"
  (constraint clearance (min 1mm))
  (constraint creepage (min 1mm))
  (condition "A.hasNetclass('BUS') && B.hasNetclass('SWNODE')"))
(rule "mains to edge"
  (constraint edge_clearance (min 3.0mm))
  (condition "A.hasNetclass('LINE') || A.hasNetclass('LIVE') || A.hasNetclass('PSU') || A.hasNetclass('NEUTRAL') || A.hasNetclass('LOAD') || A.hasNetclass('DIV1') || A.hasNetclass('DIV2') || A.hasNetclass('DIV3') || A.hasNetclass('DIV4') || A.hasNetclass('SWNODE') || A.hasNetclass('BUS')"))
(rule "copper to mounting holes"
  (constraint hole_clearance (min 3.0mm))
  (condition "B.Pad_Type == 'NPTH, mechanical'"))
(rule "high-current track width"
  (constraint track_width (min 4.5mm))
  (condition "A.hasNetclass('Mains16A')"))
(rule "C1 own leads (1 mm)"
  (constraint clearance (min 1mm))
  (condition "A.memberOfFootprint('C1') && B.memberOfFootprint('C1')"))
(rule "C1 own leads, copper into them (1 mm)"
  (constraint clearance (min 1mm))
  (condition "((A.NetName == 'VBULK1' && B.NetName == 'GND') || (A.NetName == 'GND' && B.NetName == 'VBULK1')) && (A.memberOfFootprint('C1') || B.memberOfFootprint('C1'))"))
(rule "C1 own leads, creepage (1 mm)"
  (constraint creepage (min 1mm))
  (condition "(A.NetName == 'VBULK1' && B.NetName == 'GND') || (A.NetName == 'GND' && B.NetName == 'VBULK1')"))
(rule "C2 own leads (1 mm)"
  (constraint clearance (min 1mm))
  (condition "A.memberOfFootprint('C2') && B.memberOfFootprint('C2')"))
(rule "C2 own leads, copper into them (1 mm)"
  (constraint clearance (min 1mm))
  (condition "((A.NetName == 'VBULK' && B.NetName == 'GND') || (A.NetName == 'GND' && B.NetName == 'VBULK')) && (A.memberOfFootprint('C2') || B.memberOfFootprint('C2'))"))
(rule "C2 own leads, creepage (1 mm)"
  (constraint creepage (min 1mm))
  (condition "(A.NetName == 'VBULK' && B.NetName == 'GND') || (A.NetName == 'GND' && B.NetName == 'VBULK')"))
(rule "D7 own leads (1 mm)"
  (constraint clearance (min 1mm))
  (condition "A.memberOfFootprint('D7') && B.memberOfFootprint('D7')"))
(rule "D7 own leads, copper into them (1 mm)"
  (constraint clearance (min 1mm))
  (condition "((A.NetName == 'L_RF' && B.NetName == 'VBULK1') || (A.NetName == 'VBULK1' && B.NetName == 'L_RF')) && (A.memberOfFootprint('D7') || B.memberOfFootprint('D7'))"))
(rule "D7 own leads, creepage (1 mm)"
  (constraint creepage (min 1mm))
  (condition "(A.NetName == 'L_RF' && B.NetName == 'VBULK1') || (A.NetName == 'VBULK1' && B.NetName == 'L_RF')"))
