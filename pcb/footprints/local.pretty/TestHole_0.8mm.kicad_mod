(footprint "TestHole_0.8mm" (layer "F.Cu")
  (descr "Bare plated hole for a push-in ceramic test loop (not soldered): 0.8 mm finished drill (both legs in one hole), 1.6 mm ring. SELV only.")
  (attr exclude_from_pos_files exclude_from_bom)
  (fp_text reference "TP**" (at 0 -1.6) (layer "F.Fab") (effects (font (size 0.6 0.6) (thickness 0.1))))
  (fp_text value "test hole" (at 0 1.6) (layer "F.Fab") (effects (font (size 0.6 0.6) (thickness 0.1))))
  (fp_circle (center 0 0) (end 1.0 0) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (pad "1" thru_hole circle (at 0 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask"))
)
