(footprint "FuseClip_Littelfuse_0122_6.35mm"
	(version 20240108)
	(generator "petro_board")
	(layer "F.Cu")
	(descr "One Littelfuse 102/122 series PCB fuse clip for 1/4 in (6.35 mm) fuses, straight leads (e.g. 01220088Z, 30 A). Two leads 7.62 mm apart along the fuse axis, 1.98 mm holes (Littelfuse datasheet rev. 08/25/15, Recommended Mounting Dimensions). A fuse takes two clips; for a 1 1/4 in fuse their outer holes are 34.21 mm apart (dimension A = 1.347 in), so the clip centres are 26.59 mm apart.")
