(footprint "R_Axial_FKN2WS_P15.24mm" (layer "F.Cu")
  (descr "Yageo FKN2WS fusible flameproof resistor, horizontal: body 11.5 +-1.0 x D4.6 +-0.5 mm, leads 0.8 mm (Yageo FKN datasheet), 15.24 mm pitch (as KiCad's DIN0414)")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -3.4) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "FKN2WS" (at 0 3.4) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (fp_rect (start -6.25 -2.55) (end 6.25 2.55) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -6.37 -2.67) (end 6.37 2.67) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_line (start -6.37 0) (end -6.52 0) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start 6.37 0) (end 6.52 0) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_rect (start -8.87 -2.9) (end 8.87 2.9) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (pad "1" thru_hole circle (at -7.62 0) (size 2.0 2.0) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 7.62 0) (size 2.0 2.0) (drill 1.0) (layers "*.Cu" "*.Mask"))
)
