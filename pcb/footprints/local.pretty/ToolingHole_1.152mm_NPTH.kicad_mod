(footprint "ToolingHole_1.152mm_NPTH" (layer "F.Cu")
  (descr "JLCPCB assembly tooling hole (\"Added by Customer\"): 1.152 mm unplated, no copper, solder mask 0.148 mm larger (JLCPCB help: how to add tooling holes for PCB assembly order)")
  (attr exclude_from_pos_files exclude_from_bom)
  (fp_text reference "H**" (at 0 -1.8) (layer "F.SilkS") hide (effects (font (size 0.8 0.8) (thickness 0.15))))
  (fp_text value "Tooling 1.152 NPTH" (at 0 1.8) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_circle (center 0 0) (end 1.0 0) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_circle (center 0 0) (end 1.0 0) (stroke (width 0.05) (type solid)) (fill none) (layer "B.CrtYd"))
  (pad "" np_thru_hole circle (at 0 0) (size 1.152 1.152) (drill 1.152) (layers "*.Cu" "*.Mask") (solder_mask_margin 0.148))
)
